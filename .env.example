NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://prizm:replace-me@localhost:5432/prizm
AUTH_SECRET=replace-with-at-least-32-random-characters

# Configure complete ID/secret pairs. Incomplete pairs fail validation.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Enables first-party email/password signup and sign-in.
PASSWORD_AUTH_ENABLED=false

# Local development only. Uses the earliest existing user with an active workspace membership.
# The server rejects this switch in test and production environments.
DEV_AUTH_BYPASS=false

# Base64-encoded 32-byte key reserved for encrypted integration credentials.
INTEGRATION_ENCRYPTION_KEY=

# AI drafting fails closed unless the server switch, explicit model, provider key,
# and workspace policy are all configured. Never expose these values to browsers.
AI_GENERATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Website audits are disabled until egress, monitoring, and policy review are ready.
WEBSITE_AUDIT_ENABLED=false
AUDIT_USER_AGENT=PRIZMDEV/1.0 (+https://example.com/audit-policy)
AUDIT_MAX_RESPONSE_BYTES=2000000

# Delivery remains fail-closed until a reviewed provider adapter, verified sender,
# signed webhook verifier, monitoring and staging approval are added.
CAMPAIGN_DELIVERY_ENABLED=false

# External company discovery is off by default. To enable the OpenStreetMap (Overpass) adapter,
# read its usage terms, then set all of the following. Without the terms acknowledgement and a
# contactable user agent the server refuses to start with a provider selected.
DISCOVERY_PROVIDER=none
DISCOVERY_TERMS_VERIFIED_FOR=
DISCOVERY_USER_AGENT=
# Optional https endpoint for a self-hosted or alternative Overpass instance.
OVERPASS_API_URL=
# Recommended: a locally loaded OpenStreetMap extract (see plans/discovery-local-osm-extract.md). Load the data first, then
# set DISCOVERY_PROVIDER=osm_extract and DISCOVERY_TERMS_VERIFIED_FOR=osm_extract. No user agent is needed.
# Search radius in km around the chosen place (1 to 50, default 10).
OSM_EXTRACT_RADIUS_KM=
